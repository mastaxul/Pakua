<section class="form-kewangan" style="max-width:640px;margin:0 auto;padding:20px;">
  <h2 style="text-align:center;margin-bottom:20px;">Borang Rekod Kewangan</h2>

  <form id="borangKewangan">
    <label>Tarikh</label>
    <input type="date" id="tarikh" required>

    <label>Masa</label>
    <input type="time" id="masa" required>

    <label>Cara Bayar</label>
    <select id="caraBayar" required>
      <option value="">-- Pilih --</option>
      <option value="Bank">Bank</option>
      <option value="Tunai">Tunai</option>
    </select>

    <label>Kategori</label>
    <select id="kategori" required>
      <option value="">-- Pilih --</option>
      <option>Yuran</option>
      <option>Sumbangan</option>
      <option>Tajaan</option>
      <option>Geran</option>
      <option>Jualan</option>
      <option>Program</option>
      <option>Makanan & Minuman</option>
      <option>Pengangkutan</option>
      <option>Sewa</option>
      <option>Alat Tulis</option>
      <option>Peralatan</option>
      <option>Utiliti</option>
      <option>Elaun</option>
      <option>Runcit</option>
      <option>Lain-lain</option>
    </select>

    <label>Keterangan</label>
    <textarea id="keterangan" rows="2" required></textarea>

    <label>Jumlah (RM)</label>
    <input type="number" id="jumlah" step="0.01" min="0" required>

    <label>Pembayar / Penerima</label>
    <input type="text" id="pembayarPenerima" required>

    <label>Jenis Transaksi</label>
    <select id="jenis" required>
      <option value="">-- Pilih --</option>
      <option value="Duit Masuk">Duit Masuk</option>
      <option value="Duit Keluar">Duit Keluar</option>
    </select>

    <label>Nombor Resit</label>
    <input type="text" id="noResit">

    <label>Bukti Transaksi (link ImgBB)</label>
    <input type="url" id="buktiUrl" placeholder="https://i.ibb.co/...">
    <small style="color:#888;">Upload resit di imgbb.com, kemudian paste Direct link di sini</small>

    <label>Penama Key-in</label>
    <input type="text" id="penama" required>

    <button type="submit" style="margin-top:16px;width:100%;padding:14px;background:#c41e3a;color:#fff;border:none;border-radius:8px;font-weight:700;cursor:pointer;">
      Simpan Rekod
    </button>
  </form>

  <p id="msg" style="text-align:center;margin-top:14px;"></p>
</section>

<script>
  // GANTI dengan Web App URL kau
  const API_URL = "https://script.google.com/macros/s/URL_WEB_APP_KAU/exec";

  document.getElementById("borangKewangan").addEventListener("submit", async function (e) {
    e.preventDefault();
    const msg = document.getElementById("msg");
    msg.textContent = "Sedang menyimpan...";

    const payload = {
      tarikh: document.getElementById("tarikh").value,
      masa: document.getElementById("masa").value,
      caraBayar: document.getElementById("caraBayar").value,
      kategori: document.getElementById("kategori").value,
      keterangan: document.getElementById("keterangan").value,
      jumlah: document.getElementById("jumlah").value,
      pembayarPenerima: document.getElementById("pembayarPenerima").value,
      jenis: document.getElementById("jenis").value,
      noResit: document.getElementById("noResit").value,
      buktiUrl: document.getElementById("buktiUrl").value,
      penama: document.getElementById("penama").value
    };

    try {
      await fetch(API_URL, {
        method: "POST",
        mode: "no-cors",
        headers: { "Content-Type": "text/plain" },
        body: JSON.stringify(payload)
      });
      msg.textContent = "✅ Rekod berjaya disimpan!";
      document.getElementById("borangKewangan").reset();
    } catch (err) {
      msg.textContent = "❌ Gagal menyimpan. Cuba lagi.";
    }
  });
</script>
